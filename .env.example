# Supabase → Project Settings → API (or "Connect"). Copy to .env.local and fill in.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_…) or the legacy anon key. Never the service_role/secret key.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Only for `pnpm db:migrate` (never sent to the browser: Vite only exposes VITE_* variables).
# Supabase dashboard → Connect → Session pooler → copy the URI and put your database password in it.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:YOUR-DB-PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
